DATABASE_URL="postgresql://osc_user:osc_password@postgres:5432/osc_db"
# Direct (non-pooled) connection. Referenced by prisma/schema.prisma via
# directUrl and required by every Prisma CLI command, including `generate`.
# Point it at the same database as DATABASE_URL when not using a pooler.
DIRECT_URL="postgresql://osc_user:osc_password@postgres:5432/osc_db"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
# Optional: dedicated secret for deriving the daily-rotating data API key.
# Falls back to NEXTAUTH_SECRET if not set.
API_KEY_SECRET=""

# Seed passwords. ADMIN_SEED_PASSWORD is required by `npm run db:seed`.
# WM_SEED_PASSWORD is optional and seeds a Wyer/Merkator QA user when set.
ADMIN_SEED_PASSWORD=""
WM_SEED_PASSWORD=""

# Static bearer secret for GET /api/portal-metrics, generated by the MD
# portal when this app is registered as a metric source. Unset = endpoint
# rejects all requests.
PORTAL_METRICS_SECRET=""
